---
import { articleDate, articleSummary, getArticles } from "../lib/articles";
import WritingEmpty from "./WritingEmpty.astro";

interface Props {
  heading?: "h2" | "h3";
  /** Show only the newest few Articles. */
  limit?: number;
  /** Add each Article's summary below its date. */
  summaries?: boolean;
}
const { heading: Heading = "h2", limit, summaries = false } = Astro.props;

const articles = await Promise.all(
  getArticles()
    .slice(0, limit)
    .map(async (article) => ({
      ...article,
      summary: summaries
        ? articleSummary(article.frontmatter, await article.compiledContent())
        : undefined,
    })),
);
---

{
  articles.length ? (
    <ul class="article-list">
      {articles.map(({ frontmatter, url, summary }) => (
        <li>
          <Heading>
            <a href={url}>{frontmatter.title}</a>
          </Heading>
          <time datetime={frontmatter.date}>
            {articleDate(frontmatter.date)}
          </time>
          {summary && <p class="article-summary">{summary}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <WritingEmpty heading={Heading} />
  )
}
