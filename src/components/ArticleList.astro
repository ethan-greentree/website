---
import { articleDate, getArticles } from "../lib/articles";
import WritingEmpty from "./WritingEmpty.astro";

const articles = getArticles();

interface Props {
  heading?: "h2" | "h3";
}
const { heading: Heading = "h2" } = Astro.props;
---

{
  articles.length ? (
    <ul class="article-list">
      {articles.map(({ frontmatter, url }) => (
        <li>
          <Heading>
            <a href={url}>{frontmatter.title}</a>
          </Heading>
          <time datetime={frontmatter.date}>
            {articleDate(frontmatter.date)}
          </time>
        </li>
      ))}
    </ul>
  ) : (
    <WritingEmpty heading={Heading} />
  )
}
