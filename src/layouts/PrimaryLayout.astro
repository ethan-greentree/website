---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ethan Greentree — IT & curiosity",
  description = "IT by trade. Curious by default. Ethan Greentree's personal home for technology, investigations, and things learned along the way.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch {
        // Keep the default light palette when browser storage is unavailable.
      }
    </script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="page">
      <Navbar />
      <main id="content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p>Ethan Greentree<span>Always something to figure out.</span></p>
        <div class="footer-theme-toggle"><ThemeToggle /></div>
        <a href="/contact/">Get in touch</a>
      </footer>
    </div>
  </body>
</html>
