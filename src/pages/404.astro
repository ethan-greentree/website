---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
---

<PrimaryLayout
  title="Page not found — Ethan Greentree"
  description="This page could not be found. Head back to Ethan Greentree's homepage to keep exploring."
>
  <section class="inner-page" aria-labelledby="not-found-title">
    <div class="page-heading">
      <p class="eyebrow">404 / Page not found</p>
      <h1 id="not-found-title">A wrong<br />turn.</h1>
    </div>
    <div class="prose page-copy">
      <p>The page you're looking for may have moved, or the link may be incorrect.</p>
      <a class="primary" href="/">Back to the homepage ↗</a>
    </div>
  </section>
</PrimaryLayout>
