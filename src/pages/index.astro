---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import { getArticles } from "../lib/articles";

const hasArticles = getArticles().length > 0;
---

<PrimaryLayout>
  <section class="home-opening" aria-labelledby="name">
    <h1 id="name">Ethan<br />Greentree</h1>
    <p class="lead">IT by trade.<br />Curious by default.</p>
  </section>
  <div class="home-statement">
    <p>
      I enjoy figuring out how things work and sharing what I learn along the
      way.
    </p>
  </div>
  <FeaturedProject />
  <section class="home-writing" aria-labelledby="writing-title">
    <h2 id="writing-title">Latest articles</h2>
    <ArticleList heading="h3" limit={3} summaries />
    {
      hasArticles && (
        <p class="home-more">
          <a href="/blog/">Read all my articles</a>
        </p>
      )
    }
  </section>
  <section class="home-ending" aria-labelledby="ending-title">
    <h2 id="ending-title">Happiest when something finally clicks.</h2>
    <div class="prose">
      <p>
        I've worked at KES for five years, with a few more years of tinkering on
        and off. I'm taking that learning more seriously now. I believe in
        teaching as practice.
      </p>
      <p class="home-more"><a href="/about/">Get to know me</a></p>
      <a class="primary" href="/contact/">Say hello</a>
    </div>
  </section>
</PrimaryLayout>
