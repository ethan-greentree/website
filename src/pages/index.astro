---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import AboutCopy from "../components/AboutCopy.astro";
import ArticleList from "../components/ArticleList.astro";
---

<PrimaryLayout>
  <div class="composition">
    <section class="home-intro" aria-labelledby="name">
      <p class="eyebrow">A personal site / Technology & curiosity</p>
      <h1 id="name">Ethan<br />Greentree</h1>
      <div class="intro-copy">
        <p class="lead">IT by trade.<br />Curious by default.</p>
        <p>
          I enjoy figuring out how things work and sharing what I learn along
          the way.
        </p>
        <a class="primary" href="#writing">Explore the articles</a>
      </div>
    </section>
    <section class="writing" id="writing" aria-labelledby="writing-title">
      <div class="section-head">
        <h2 id="writing-title">Articles</h2>
        <span class="eyebrow">Ideas, investigations & notes</span>
      </div>
      <ArticleList heading="h3" />
    </section>
  </div>
  <section class="about-section" id="about" aria-labelledby="about-title">
    <h2 id="about-title">A little<br />about me.</h2>
    <div class="prose"><AboutCopy /></div>
  </section>
</PrimaryLayout>
